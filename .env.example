# Получить на https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+7XXXXXXXXXX

# Получить на https://console.anthropic.com
ANTHROPIC_API_KEY=

# ВКонтакте: создать приложение на https://vk.com/apps?act=manage
# Тип «Standalone» или «Сервисное» → скопировать сервисный ключ доступа
VK_SERVICE_TOKEN=

# Max-мессенджер: зарегистрировать бота через @MaxBot в Max
# После регистрации добавить бота в каналы и запустить: python fetch_max.py --discover
MAX_BOT_TOKEN=

# Instagram: обычный аккаунт (рекомендуется отдельный бот-аккаунт)
# Сессия кешируется в ig_session.json после первого входа
IG_USERNAME=
IG_PASSWORD=

# DeepSeek API (запасной ключ, если LLM_API_KEY не задан)
# Получить на https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Основная LLM парсера — Yandex AI Studio (OpenAI-совместимый API, бесплатно для физлиц).
# 1. Зарегистрируйтесь на https://aistudio.yandex.ru/
# 2. Получите API-ключ: Yandex Cloud → сервисный аккаунт → создать API-ключ
#    (нужна роль ai.languageModels.user)
# 3. YANDEX_FOLDER_ID — id каталога Yandex Cloud, где создан сервисный аккаунт
YANDEX_FOLDER_ID=
LLM_API_KEY=
# LLM_API_URL=https://ai.api.cloud.yandex.net/v1/chat/completions
# LLM_MODEL=
