# Получить на https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+7XXXXXXXXXX

# Получить на https://console.anthropic.com
ANTHROPIC_API_KEY=

# ВКонтакте: создать приложение на https://vk.com/apps?act=manage
# Тип «Standalone» или «Сервисное» → скопировать сервисный ключ доступа
VK_SERVICE_TOKEN=

# Max-мессенджер: зарегистрировать бота через @MaxBot в Max
# После регистрации добавить бота в каналы и запустить: python fetch_max.py --discover
MAX_BOT_TOKEN=

# Instagram: обычный аккаунт (рекомендуется отдельный бот-аккаунт)
# Сессия кешируется в ig_session.json после первого входа
IG_USERNAME=
IG_PASSWORD=
