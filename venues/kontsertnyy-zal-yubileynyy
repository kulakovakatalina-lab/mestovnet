  font-family: var(--font-body);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
button { font: inherit; background: none; border: none; cursor: pointer; }

.nav {
  position: sticky;
  top: 0;
  z-index: 100;
  height: var(--nav-h);
  background: oklch(99% 0.002 240 / 0.92);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 var(--gutter);
  gap: 8px;
}

.nav-logo {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.035em;
  flex-shrink: 0;
  color: var(--fg);
}
.nav-logo em { color: var(--accent); font-style: normal; }

.nav-sep { width: 1px; height: 20px; background: var(--border); margin: 0 8px; flex-shrink: 0; }

.nav-genres {
  display: flex;
  gap: 2px;
  overflow-x: auto;
  scrollbar-width: none;
  flex: 1;
}
.nav-genres::-webkit-scrollbar { display: none; }

.nav-genre {
  padding: 5px 13px;
  font-size: 13px;
  font-weight: 500;
  color: var(--muted);
  border-radius: 100px;
  white-space: nowrap;
  transition: color 0.12s, background 0.12s;
}
.nav-genre:hover { color: var(--fg); background: var(--border); }

.genre-strip-mobile {
  display: none;
  overflow-x: auto;
  scrollbar-width: none;
  gap: 6px;
  padding: 10px var(--gutter);
  border-bottom: 1px solid var(--border);
  background: var(--surface);
}
.genre-strip-mobile::-webkit-scrollbar { display: none; }
.genre-strip-mobile a {
  flex-shrink: 0;
  padding: 5px 14px;
  border: 1px solid var(--border);
  border-radius: 100px;
  font-size: 13px;
  font-weight: 500;
  color: var(--muted);
  white-space: nowrap;
  transition: all 0.12s;
}
.genre-strip-mobile a:hover { border-color: var(--fg); color: var(--fg); }

/* —— Кнопка подписки в шапке —— */
.nav-cta {
  flex-shrink: 0;
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 16px;
  font-size: 13px;
  font-weight: 600;
  color: #fff;
  background: var(--accent);
  border: none;
  border-radius: 100px;
  white-space: nowrap;
  transition: filter 0.12s, transform 0.1s;
}
.nav-cta:hover { filter: brightness(1.08); }
.nav-cta:active { transform: scale(0.96); }
.nav-cta:focus { outline: none; }
.nav-cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.nav-cta svg { width: 15px; height: 15px; flex-shrink: 0; }

/* —— Модалка подписки —— */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: oklch(18% 0.012 250 / 0.45);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s ease, visibility 0.2s ease;
}
.modal-overlay.open { opacity: 1; visibility: visible; }
.modal {
  position: relative;
  width: 100%;
  max-width: 420px;
  padding: 36px 32px 32px;
  background: var(--surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 24px 70px oklch(18% 0.012 250 / 0.28);
  transform: translateY(14px) scale(0.98);
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}
.modal-overlay.open .modal { transform: translateY(0) scale(1); }
.modal-close {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--muted);
  font-size: 20px;
  line-height: 1;
  transition: background 0.12s, color 0.12s;
}
.modal-close:hover { background: var(--border); color: var(--fg); }
.modal-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  margin-bottom: 18px;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  background: oklch(58% 0.18 255 / 0.1);
  border-radius: 100px;
}
.modal-badge svg { width: 13px; height: 13px; }
.modal-title {
  font-family: var(--font-display);
  font-size: 26px;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin-bottom: 12px;
}
.modal-lead {
  font-size: 15px;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 22px;
}
.modal-list { list-style: none; margin-bottom: 28px; }
.modal-list li {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  padding: 9px 0;
  font-size: 14.5px;
  line-height: 1.45;
  border-top: 1px solid var(--border);
}
.modal-list li:first-child { border-top: none; }
.modal-list .ico {
  flex-shrink: 0;
  width: 22px;
  height: 22px;
  margin-top: 1px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: oklch(58% 0.18 255 / 0.12);
  color: var(--accent);
  font-size: 13px;
}
.modal-list b { font-weight: 600; }
.modal-list span { color: var(--muted); }
.modal-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 14px;
  font-size: 15px;
  font-weight: 600;
  color: #fff;
  background: var(--accent);
  border-radius: var(--radius);
  transition: filter 0.12s, transform 0.1s;
}
.modal-cta:hover { filter: brightness(1.08); }
.modal-cta:active { transform: scale(0.99); }
.modal-cta svg { width: 18px; height: 18px; }
.modal-note {
  margin-top: 14px;
  text-align: center;
  font-size: 12.5px;
  color: var(--muted);
}

.hero {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: clamp(40px, 7vw, 72px) var(--gutter);
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 48px;
  align-items: center;
}

.hero-eyebrow {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 20px;
}

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(38px, 5.5vw, 72px);
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1.0;
  color: var(--fg);
  margin-bottom: 20px;
}

.hero-sub {
  font-size: clamp(15px, 1.8vw, 17px);
  color: var(--muted);
  line-height: 1.65;
  max-width: 460px;
  margin-bottom: 36px;
}

.hero-stats {
  display: flex;
  gap: 36px;
}
.hero-stat-n {
  font-family: var(--font-mono);
  font-size: 32px;
  font-weight: 700;
  color: var(--fg);
  letter-spacing: -0.04em;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.hero-stat-l {
  font-size: 12px;
  color: var(--muted);
  margin-top: 4px;
  letter-spacing: 0.01em;
}

.featured {
  background: var(--fg);
  color: var(--bg);
  border-radius: var(--radius-lg);
  padding: 0;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.featured-poster {
  width: 100%;
  height: 200px;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
}
.featured-poster img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}
.featured-poster-bg {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, oklch(22% 0.06 255) 0%, oklch(14% 0.04 270) 60%, oklch(18% 0.08 220) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.featured-poster-bg svg { opacity: 0.18; }
.featured-poster::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80px;
  background: linear-gradient(to bottom, transparent, var(--fg));
  pointer-events: none;
}

.featured-body {
  padding: 24px 32px 32px;
  position: relative;
}
.featured-body::after {
  content: '';
  position: absolute;
  top: -80px;
  right: -80px;
  width: 260px;
  height: 260px;
  border-radius: 50%;
  background: var(--accent);
  opacity: 0.08;
  pointer-events: none;
}

.featured-label {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: oklch(75% 0 0);
  margin-bottom: 16px;
}
.featured-genre {
  display: inline-flex;
  align-items: center;
  padding: 4px 12px;
  background: var(--accent);
  color: #fff;
  border-radius: 100px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  margin-bottom: 16px;
}
.featured-artist {
  font-family: var(--font-display);
  font-size: clamp(22px, 3vw, 28px);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: 10px;
}
.featured-desc {
  font-size: 14px;
  color: oklch(72% 0 0);
  line-height: 1.55;
  margin-bottom: 24px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.featured-meta {
  display: flex;
  flex-direction: column;
  gap: 9px;
  margin-bottom: 28px;
}
.featured-meta-row {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: oklch(80% 0 0);
}
.featured-meta-icon {
  width: 15px;
  height: 15px;
  flex-shrink: 0;
  opacity: 0.55;
}
.featured-link {
  display: contents;
  color: inherit;
  text-decoration: none;
}
.featured-price {
  display: block;
  font-family: var(--font-mono);
  font-size: 12px;
  color: oklch(65% 0 0);
  margin-top: 12px;
  font-variant-numeric: tabular-nums;
}

.divider {
  height: 1px;
  background: var(--border);
  margin: 0 var(--gutter);
}

.section {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: clamp(32px, 5vw, 56px) var(--gutter);
}
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
}
.section-title {
  font-family: var(--font-display);
  font-size: clamp(20px, 2.5vw, 28px);
  font-weight: 700;
  letter-spacing: -0.03em;
}
.section-link {
  font-size: 13px;
  color: var(--accent);
  font-weight: 500;
  white-space: nowrap;
}
.section-link:hover { text-decoration: underline; }

.city-pills {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  scrollbar-width: none;
  padding-bottom: 2px;
  margin-bottom: 0;
}
.city-pills::-webkit-scrollbar { display: none; }
.city-pill {
  flex-shrink: 0;
  padding: 7px 16px;
  border: 1px solid var(--border);
  border-radius: 100px;
  font-size: 13px;
  font-weight: 500;
  color: var(--muted);
  transition: all 0.12s;
}
.city-pill:hover { border-color: oklch(78% 0.01 250); color: var(--fg); }
.city-pill.active {
  background: var(--fg);
  border-color: var(--fg);
  color: var(--bg);
}

.events-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  gap: 12px;
}

.event-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: border-color 0.12s, box-shadow 0.12s, transform 0.15s;
  cursor: pointer;
  text-decoration: none;
}
.event-card:hover {
  border-color: oklch(80% 0.008 250);
  box-shadow: 0 4px 20px oklch(18% 0.012 250 / 0.05);
  transform: translateY(-2px);
}

.card-img {
  width: 100%;
  aspect-ratio: 1;
  flex-shrink: 0;
  overflow: hidden;
  background: oklch(22% 0.01 250);
}
.card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
  transition: transform 0.3s ease;
}
.event-card:hover .card-img img { transform: scale(1.04); }

.card-body {
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.event-date-day {
  font-family: var(--font-mono);
  font-size: 30px;
  font-weight: 700;
  color: var(--fg);
  letter-spacing: -0.05em;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.event-date-rest {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-top: 3px;
}

.pill {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 100px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.02em;
  white-space: nowrap;
}
.pill-jazz    { background: oklch(58% 0.18 255 / 0.10); color: var(--accent); }
.pill-rock    { background: oklch(55% 0.15 15  / 0.10); color: oklch(50% 0.15 15); }
.pill-folk    { background: oklch(50% 0.12 150 / 0.10); color: oklch(46% 0.12 150); }
.pill-blues   { background: oklch(52% 0.14 270 / 0.10); color: oklch(50% 0.16 270); }
.pill-classic { background: oklch(52% 0.10 60  / 0.10); color: oklch(46% 0.10 60); }
.pill-pop     { background: oklch(58% 0.16 320 / 0.10); color: oklch(54% 0.16 320); }

.event-artist {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.2;
  color: var(--fg);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.event-venue {
  font-size: 13px;
  color: var(--muted);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.event-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10px;
  border-top: 1px solid var(--border);
  margin-top: auto;
}
.event-time {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}
.event-price {
  font-size: 13px;
  font-weight: 600;
  color: var(--fg);
}

.genre-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  gap: 10px;
}
.genre-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: border-color 0.12s, background 0.12s;
}
.genre-card:hover {
  border-color: var(--accent);
  background: oklch(58% 0.18 255 / 0.03);
}
.genre-card-name {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.02em;
}
.genre-card-count {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

footer {
  border-top: 1px solid var(--border);
  padding: 32px var(--gutter);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  max-width: var(--max-w);
  margin: 0 auto;
}
.footer-logo {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--fg);
}
.footer-logo em { color: var(--accent); font-style: normal; }
.footer-note { font-size: 13px; color: var(--muted); }

.bg-jazz    { background: linear-gradient(135deg, oklch(22% 0.04 255), oklch(32% 0.08 255)); }
.bg-folk    { background: linear-gradient(135deg, oklch(24% 0.04 155), oklch(34% 0.08 145)); }
.bg-rock    { background: linear-gradient(135deg, oklch(22% 0.04 15),  oklch(32% 0.06 20)); }
.bg-blues   { background: linear-gradient(135deg, oklch(22% 0.06 270), oklch(30% 0.10 265)); }
.bg-classic { background: linear-gradient(135deg, oklch(28% 0.06 65),  oklch(36% 0.09 58)); }
.bg-pop     { background: linear-gradient(135deg, oklch(30% 0.10 325), oklch(40% 0.14 310)); }
.bg-default { background: linear-gradient(135deg, oklch(22% 0.06 255), oklch(14% 0.04 270), oklch(18% 0.08 220)); }

.loading {
  text-align: center;
  padding: 80px 0;
  color: var(--muted);
  font-size: 15px;
}

@media (max-width: 1024px) {
  .hero { grid-template-columns: 1fr 380px; gap: 32px; }
}

@media (max-width: 860px) {
  .hero { grid-template-columns: 1fr; min-height: auto; }
  .hero-sub { max-width: 100%; }
}

@media (max-width: 600px) {
  :root { --nav-h: 52px; }
  .nav-genres, .nav-sep { display: none; }
  .genre-strip-mobile { display: flex; }
  .hero-title { letter-spacing: -0.03em; }
  .hero-stats { gap: 24px; }
  .featured { padding: 24px; }
  .events-grid { grid-template-columns: 1fr; }
  .genre-grid { grid-template-columns: 1fr 1fr; }
  footer { flex-direction: column; align-items: flex-start; }
}

@media (max-width: 420px) {
  .hero-stats { gap: 16px; }
  .hero-stat-n { font-size: 26px; }
  .genre-grid { grid-template-columns: 1fr; }
}

.load-more-wrap {
  text-align: center;
  margin-top: 24px;
}
