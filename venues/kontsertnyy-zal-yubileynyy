  padding: 10px 28px;
  font-size: 14px;
  font-weight: 500;
  color: var(--accent);
  border: 1px solid var(--accent);
  border-radius: 100px;
  background: none;
  cursor: pointer;
  transition: all 0.12s;
}
.load-more-btn:hover {
  background: var(--accent);
  color: var(--surface);
}
.load-more-btn:disabled {
  opacity: 0.4;
  cursor: default;
  pointer-events: none;
}

