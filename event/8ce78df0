              <button class="carousel-btn carousel-btn-next" id="carouselNext">&#8250;</button>
              <div class="carousel-dots" id="carouselDots">
                ${images.map((_, i) => `<span class="carousel-dot${i === 0 ? ' active' : ''}" data-slide="${i}"></span>`).join('')}
