  let id = params.get('id');
  if (!id) {
    const m = window.location.pathname.match(/\/event\/([^\/]+)/);
    if (m) id = decodeURIComponent(m[1]);
  }
  const idxFallback = parseInt(params.get('idx'));
  console.log('id:', id, 'idx fallback:', idxFallback);

  try {
    const [res, settingsRes, venuesRes, artistsRes] = await Promise.all([
      fetch('/events.json'),
      fetch('/settings.json').catch(() => null),
      fetch('/venues.json').catch(() => null),
      fetch('/artists.json').catch(() => null)
    ]);
    console.log('fetch status:', res.status);
    const data = await res.json();
    console.log('data length:', data.length);

    // Применяем настройки из settings.json
    let settings = {};
    if (settingsRes && settingsRes.ok) {
      settings = await settingsRes.json().catch(() => ({}));
    }
    const hiddenSet   = new Set(settings.hidden || []);
    const cancelledSet = new Set(settings.cancelled || []);
    const ovNames     = settings.names        || {};
    const ovTimes     = settings.times        || {};
    const ovPrices    = settings.prices       || {};
    const ovImages    = settings.images       || {};
    const ovCities    = settings.cities       || {};
    const ovVenues    = settings.venues       || {};
    const ovDescs     = settings.descriptions || {};
    const ovGenres    = settings.genres       || {};

    if (venuesRes && venuesRes.ok) {
      const venuesList = await venuesRes.json().catch(() => []);
      venuesList.forEach(v => {
        (v.aliases || []).forEach(alias => { venueByAlias[alias] = v; });
        venueByAlias[v.name] = v;
      });
    }

    if (artistsRes && artistsRes.ok) {
      const artistsList = await artistsRes.json().catch(() => []);
      artistsList.forEach(a => {
        (a.aliases || []).forEach(alias => { artistByAlias[alias] = a; });
        artistByAlias[a.name] = a;
      });
    }

    function applySettings(e) {
      const url = e.source_url || '';
      if (hiddenSet.has(url)) return null;
      const ev = { ...e };
      if (url in ovNames)   ev.artist      = ovNames[url];
      if (url in ovTimes)   ev.time        = ovTimes[url];
      if (url in ovPrices)  ev.price       = ovPrices[url];
      if (url in ovImages)  ev.image       = ovImages[url] === null ? null : ovImages[url];
      if (url in ovCities)  ev.source_city = ovCities[url];
      if (url in ovVenues)  ev.venue       = ovVenues[url];
      if (url in ovDescs)   ev.description = ovDescs[url];
      if (url in ovGenres)  ev.genre       = ovGenres[url];
      if (cancelledSet.has(url)) ev.cancelled = true;
      return ev;
    }

    const patched = data.map((e, i) => {
      const ev = applySettings(e);
      return ev ? { ...ev, _origIdx: i } : null;
    });

    const now = new Date();

    const enrich = e => ({
      ...e,
      dateObj: parseDate(e.date),
      genre: mapGenre(e.genre),
      dateFmt: {
        day: String(parseDate(e.date).getDate()).padStart(2, '0'),
        month: MONTHS_GEN[parseDate(e.date).getMonth()],
        monthShort: ['янв','фев','мар','апр','мая','июн','июл','авг','сен','окт','ноя','дек'][parseDate(e.date).getMonth()],
        dow: DOW_FULL[parseDate(e.date).getDay()],
        full: `${parseDate(e.date).getDate()} ${MONTHS_GEN[parseDate(e.date).getMonth()]} ${parseDate(e.date).getFullYear()}`
      },
      priceDisplay: priceText(e.price),
      globalIdx: e._origIdx
    });

    // все события с датой (прошедшие + предстоящие), чтобы открывалась и страница архивного события
    allEvents = patched.filter(Boolean).filter(e => e.date).map(enrich);

    const upcoming = allEvents
      .filter(e => parseDateTime(e) >= now)
      .sort((a, b) => a.dateObj - b.dateObj || (a.time || '').localeCompare(b.time || ''));

    let event;
    if (id) {
      event = allEvents.find(e => e.id === id);
    } else if (!isNaN(idxFallback)) {
      event = allEvents.find(e => e.globalIdx === idxFallback);
    }
    event = event || upcoming[0];
    if (!event) { document.getElementById('content').innerHTML = '<div class="loading">Событие не найдено</div>'; return; }

    currentEventId = event.id;
    const otherUpcoming = upcoming.filter(e => e.id !== currentEventId);
    const sameGenre = otherUpcoming.filter(e => e.genre === event.genre);
    isSameGenreList = sameGenre.length > 0;
    allUpcoming = isSameGenreList ? sameGenre : otherUpcoming;
    shownCount = 4;

    renderNavGenres();
    render(event);
  } catch (err) {
    console.error('load error:', err);
    document.getElementById('content').innerHTML = '<div class="loading">Не удалось загрузить: ' + escapeHtml(err.message) + '</div>';
  }
}

