      <div class="mini-img ${e.image ? 'bg-'+e.genre : 'bg-default'}">${e.image ? `<img src="${safeUrl(e.image)}" alt="${escapeHtml(e.artist)}" loading="lazy" onerror="this.parentElement.className='mini-img bg-default';this.parentElement.innerHTML=starIcon">` : starIcon}</div>
      <div class="mini-body">
        <div class="mini-date">${e.dateFmt.day} ${e.dateFmt.monthShort}${e.time ? ` · ${escapeHtml(e.time)}` : ''}</div>
        <div class="mini-artist">${e.cancelled ? '<span class="cancelled-badge">Отменено</span> ' : ''}${escapeHtml(e.artist) || '—'}</div>
        <div class="mini-venue">${escapeHtml(e.venue) || '—'} · ${escapeHtml(e.source_city) || '—'}</div>
      </div>
    </a>
  `).join('');

  const html = `
    <div class="event-hero">
      <div class="event-hero-inner">
        <a href="javascript:history.back()" class="event-back">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 3L5 8l5 5"/>
          </svg>
          Назад
        </a>
        <div class="event-hero-grid">
          <div class="event-poster-col">${posterHtml}</div>
          <div class="event-content-col">
          <div class="event-info">
            <span class="event-info-genre">${GENRE_LABELS[event.genre]}</span>
            ${event.cancelled ? '<span class="cancelled-badge event-info-cancelled">Мероприятие отменено</span>' : ''}
            <h1 class="event-info-artist">${escapeHtml(event.artist) || '—'}</h1>
            <div class="event-info-venue">${(function(){
              const vd = venueByAlias[event.venue || ''];
              const name = escapeHtml(event.venue) || '—';
              const city = escapeHtml(event.source_city) || '—';
              return (vd ? `<a href="/venues/${escapeHtml(vd.slug)}">${name}</a>` : name) + ' · ' + city;
            })()}</div>
            <div class="event-info-meta">
              <div class="event-info-meta-item">
                <span class="event-info-meta-label">Дата</span>
                <span class="event-info-meta-value">${event.dateFmt.full}</span>
              </div>
              ${event.time ? `
              <div class="event-info-meta-item">
                <span class="event-info-meta-label">Начало</span>
                <span class="event-info-meta-value mono">${escapeHtml(event.time)}</span>
              </div>` : ''}
              <div class="event-info-meta-item">
                <span class="event-info-meta-label">Стоимость</span>
                <span class="event-info-meta-value">${escapeHtml(event.priceDisplay)}</span>
              </div>
            </div>
            <div class="event-info-actions">
              ${(function(){
                const going = isWantToGo(event.id);
                const ticketIcon = '<path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a2 2 0 1 0 0 4v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 1 0 0-4V8z"/><line x1="10" y1="6" x2="10" y2="18" stroke-dasharray="2 2"/>';
                const checkIcon = '<path d="M20 6L9 17l-5-5"/>';
                return `
              <a href="${wantToGoUrl(event.id)}" target="_blank" rel="noopener" class="event-want-btn${going ? ' is-going' : ''}" id="wantBtn" onclick="markWantToGo('${escapeHtml(event.id)}')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" id="wantBtnIcon">${going ? checkIcon : ticketIcon}</svg>
                <span id="wantBtnText">Я пойду!</span>
              </a>`;
              })()}
              <a href="${safeUrl(event.source_url) || '#'}" target="_blank" rel="noopener" class="event-source-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15,3 21,3 21,9"/><line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
                Источник
              </a>
              <button class="event-copy-btn" onclick="handleCopyLink()" aria-label="Скопировать ссылку" title="Скопировать ссылку">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="11" height="11" rx="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="event-main">
            <div class="section-label">О мероприятии</div>
            <p class="about-text">${escapeHtml(event.description) || 'Информация уточняется.'}</p>
            <div class="about-genre"><span class="pill pill-${event.genre}">${GENRE_LABELS[event.genre]}</span></div>
            ${(function(){
              const matched = resolveArtists(event.artist || '');
              if (!matched.length) return '';
              return `<div class="event-info-artist-links">` + matched.map(a =>
                `<a href="/artist/${escapeHtml(a.slug)}" class="artist-more-link">${escapeHtml(a.name)}: подробнее</a>`
              ).join('') + `</div>`;
            })()}

            ${(function(){
              const vd = venueByAlias[event.venue || ''];
              const hasCoords = vd && typeof vd.lat === 'number' && typeof vd.lon === 'number';
              if (!hasCoords) return '';
              const name = escapeHtml(event.venue) || '—';
              const city = escapeHtml(event.source_city) || '—';
              const nameHtml = vd ? `<a href="/venues/${escapeHtml(vd.slug)}">${name}</a>` : name;
              const mapHtml = `<div class="event-venue-map-wrap"><div id="event-venue-map"><div class="event-venue-map-loading">Загрузка карты…</div></div></div>`;
              return `<div class="section-label">Место проведения</div><div class="venue-info"><div class="venue-name">${nameHtml}, ${city}</div>${mapHtml}</div>`;
            })()}
          </div>
        </div>
        </div>
      </div>
    </div>

    <div class="more-section">
      <div class="more-header">
        <div class="more-title">${isSameGenreList ? `Другие мероприятия в жанре «${GENRE_LABELS[event.genre]}»` : 'Другие мероприятия'}</div>
      </div>
      <div class="more-grid" id="more-grid">${moreCards}</div>
      <div class="load-more-wrap">
        <button class="load-more-btn" id="load-more-btn" onclick="loadMore()">Показать ещё</button>
      </div>
    </div>
  `;

  document.getElementById('content').innerHTML = html;
  initCarousel();
  updateLoadMoreBtn();
  initVenueMap(venueByAlias[event.venue || ''], event.source_city);
}

let ymapsLoading = null;
function loadYmaps() {
  if (window.ymaps) return Promise.resolve();
  if (!ymapsLoading) {
    ymapsLoading = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://api-maps.yandex.ru/2.1/?apikey=3085f395-0b2b-474d-aaeb-da26978e3e5c&lang=ru_RU';
      script.onload = resolve;
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }
  return ymapsLoading;
}

function initVenueMap(vd, city) {
  const el = document.getElementById('event-venue-map');
  if (!el || !vd || typeof vd.lat !== 'number' || typeof vd.lon !== 'number') return;
  const lat = vd.lat, lon = vd.lon;
  loadYmaps().then(() => ymaps.ready(() => {
    if (!document.getElementById('event-venue-map')) return; // ушли со страницы, пока грузилась карта
    el.innerHTML = '';
    const addr = [vd.address, city].filter(Boolean).join(', ') || 'Крым';
    const routeUrl = `https://yandex.ru/maps/?rtext=~${lat},${lon}`;
    const balloonContent = `<div class="balloon-card">`
      + `<div class="balloon-name">${escapeHtml(vd.name)}</div>`
      + `<div class="balloon-addr">${escapeHtml(addr)}</div>`
      + `<a class="balloon-route" href="${routeUrl}" target="_blank" rel="noopener">Как проехать?</a>`
      + `</div>`;
    const map = new ymaps.Map(el, { center: [lat, lon], zoom: 16, controls: ['zoomControl'] });
    const placemark = new ymaps.Placemark([lat, lon], {
      hintContent: vd.name,
      balloonContent,
    }, { preset: 'islands#blueDotIcon' });
    map.geoObjects.add(placemark);
    // Карта инициализируется в узкой карточке внутри CSS-грида — размер
    // контейнера на момент создания карты может ещё измениться (шрифты,
    // разметка). Яндекс.Карты сами не подстраиваются под ресайз контейнера.
    requestAnimationFrame(() => map.container.fitToViewport());
    window.addEventListener('resize', () => map.container.fitToViewport());
  })).catch(() => {
    if (el) el.innerHTML = '<div class="event-venue-map-loading">Не удалось загрузить карту</div>';
  });
}

function initCarousel() {
  const slides = document.querySelectorAll('.carousel-slide');
  const dots = document.querySelectorAll('.carousel-dot');
  const prevBtn = document.getElementById('carouselPrev');
  const nextBtn = document.getElementById('carouselNext');
  if (!slides.length) return;

  let current = 0;

  function goTo(idx) {
    slides[current].classList.remove('active');
    dots[current].classList.remove('active');
    current = (idx + slides.length) % slides.length;
    slides[current].classList.add('active');
    dots[current].classList.add('active');
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => goTo(parseInt(dot.dataset.slide)));
  });
  if (prevBtn) prevBtn.addEventListener('click', () => goTo(current - 1));
  if (nextBtn) nextBtn.addEventListener('click', () => goTo(current + 1));
}

function loadMore() {
  shownCount += 8;
  renderMoreCards();
  updateLoadMoreBtn();
}

function renderMoreCards() {
  const visible = allUpcoming.slice(0, shownCount);
  const moreCards = visible.map(e => `
    <a href="/event/${escapeHtml(e.id)}" class="mini-card${e.cancelled ? ' cancelled' : ''}">
      <div class="mini-img ${e.image ? 'bg-'+e.genre : 'bg-default'}">${e.image ? `<img src="${safeUrl(e.image)}" alt="${escapeHtml(e.artist)}" loading="lazy" onerror="this.parentElement.className='mini-img bg-default';this.parentElement.innerHTML=starIcon">` : starIcon}</div>
      <div class="mini-body">
        <div class="mini-date">${e.dateFmt.day} ${e.dateFmt.monthShort}${e.time ? ` · ${escapeHtml(e.time)}` : ''}</div>
        <div class="mini-artist">${e.cancelled ? '<span class="cancelled-badge">Отменено</span> ' : ''}${escapeHtml(e.artist) || '—'}</div>
        <div class="mini-venue">${escapeHtml(e.venue) || '—'} · ${escapeHtml(e.source_city) || '—'}</div>
      </div>
    </a>
  `).join('');
  document.getElementById('more-grid').innerHTML = moreCards;
}

function updateLoadMoreBtn() {
  const btn = document.getElementById('load-more-btn');
  if (!btn) return;
  if (shownCount >= allUpcoming.length) {
    btn.disabled = true;
    btn.textContent = 'Все загружены';
  } else {
    btn.disabled = false;
    btn.textContent = `Показать ещё (${allUpcoming.length - shownCount})`;
  }
}

function renderNavGenres() {
  const counts = {};
  const now = new Date();
  allEvents.filter(e => e.date && parseDateTime(e) >= now)
    .forEach(e => { counts[e.genre] = (counts[e.genre] || 0) + 1; });
  const order = ['jazz', 'rock', 'folk', 'blues', 'classic', 'pop'];
  const active = order.filter(g => counts[g]);

  const navHtml = active.map(g =>
    `<a href="/genre/${g}/" class="nav-genre">${GENRE_LABELS[g]}</a>`
  ).join('');
  document.getElementById('nav-genres').innerHTML = navHtml;

  const mobileHtml = active.map(g =>
    `<a href="/genre/${g}/">${GENRE_LABELS[g]}</a>`
  ).join('');
  document.getElementById('genre-strip-mobile').innerHTML = mobileHtml;
}

load();
